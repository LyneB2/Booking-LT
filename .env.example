# Supply as cloud runtime secrets. Never put production values in tests.
APP_ORIGIN=http://localhost:3000
SUPABASE_URL=https://your-development-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Server only, least-privilege booking_app login (transaction pooler for Vercel).
DATABASE_URL=postgresql://booking_app:password@host:5432/postgres?sslmode=require
# Operator only; do not configure in the web host.
# MIGRATION_DATABASE_URL=postgresql://migration-owner:password@host:5432/postgres?sslmode=require
# BOOTSTRAP_ADMIN_USER_ID=confirmed-supabase-user-uuid
